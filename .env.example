# ==============================================================================
# MOVIE WEB — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (or backend/.env and frontend/.env.local) and adjust values.
# NEVER commit real production secrets, passwords or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# For Production: Use your managed cloud PostgreSQL URL (RDS, Supabase, Neon, etc.)
# For Local Dev: Default embedded / local instance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=movieweb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movieweb?schema=public

# ------------------------------------------------------------------------------
# 2. BACKEND & RUNTIME CONFIGURATION (NestJS)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# JWT Authentication (Use a cryptographically secure random string in production)
JWT_SECRET=super_secret_jwt_key_movie_web_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list of URLs or * for development)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# API Security & Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# API Documentation (Set to false to hide Swagger in production)
ENABLE_SWAGGER=true

# ------------------------------------------------------------------------------
# 3. TMDB API CONFIGURATION (Movie Metadata Source)
# ------------------------------------------------------------------------------
# Register at https://www.themoviedb.org to obtain an API key (v3 auth)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Next.js 14)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
