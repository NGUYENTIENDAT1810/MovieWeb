datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  favorites    Favorite[]
  watchHistory WatchHistory[]

  @@map("users")
}

model Movie {
  id               String         @id @default(uuid())
  externalId       String?
  title            String
  originalTitle    String?
  slug             String         @unique
  overview         String?        @db.Text
  posterUrl        String?
  backdropUrl      String?
  releaseDate      DateTime?
  releaseYear      Int?
  rating           Float?         @default(0)
  voteCount        Int?           @default(0)
  runtime          Int?
  status           String?
  country          String?
  originalLanguage String?
  source           String?        @default("TMDB")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  genres           MovieGenre[]
  episodes         Episode[]
  favorites        Favorite[]
  watchHistory     WatchHistory[]

  @@unique([externalId, source])
  @@index([slug])
  @@index([releaseYear])
  @@index([rating])
  @@map("movies")
}

model Genre {
  id        String       @id @default(uuid())
  name      String       @unique
  slug      String       @unique
  movies    MovieGenre[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("genres")
}

model MovieGenre {
  movieId String
  genreId String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("movie_genres")
}

model Episode {
  id            String         @id @default(uuid())
  movieId       String
  externalId    String?
  episodeNumber Int            @default(1)
  seasonNumber  Int            @default(1)
  title         String
  overview      String?        @db.Text
  thumbnailUrl  String?
  duration      Int?
  videoUrl      String?
  subtitleUrl   String?
  source        String?        @default("TMDB")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  movie         Movie          @relation(fields: [movieId], references: [id], onDelete: Cascade)
  watchHistory  WatchHistory[]

  @@unique([movieId, seasonNumber, episodeNumber])
  @@map("episodes")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("favorites")
}

model WatchHistory {
  id              String   @id @default(uuid())
  userId          String
  movieId         String
  episodeId       String?
  progressSeconds Int      @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie           Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@map("watch_histories")
}
